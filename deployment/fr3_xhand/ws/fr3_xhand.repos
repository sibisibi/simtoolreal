# Pinned external sources for the deploy workspace. libfranka is NOT built
# here, the proven install at ~/ws/franka/install (0.19.0, validated against
# the robot in the July LeFranX run logs) is consumed via CMAKE_PREFIX_PATH.
repositories:
  franka_ros2:
    type: git
    url: https://github.com/frankarobotics/franka_ros2.git
    version: 9faaaaf  # humble, release 2.5.1, requires Franka >= 0.13.2
  franka_description:
    type: git
    url: https://github.com/frankarobotics/franka_description.git
    version: 02afaae  # release 2.8.1
